# Copiez ce fichier en ".env" et changez le mot de passe admin avant tout déploiement réel.

# Compte administrateur créé automatiquement au premier démarrage.
# Utilisez-le pour créer ensuite les comptes des collecteurs depuis l'onglet "Comptes".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Mettre à "false" uniquement pour tester en local sans HTTPS.
COOKIE_SECURE=true

# Durée de la session avant reconnexion demandée (en heures).
SESSION_HOURS=12

# Emplacement du fichier de base de données SQLite (laissé par défaut la plupart du temps).
# DB_PATH=/app/data/data.db
